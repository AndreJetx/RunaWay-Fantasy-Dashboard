############################################
# Runtime / server
############################################
NODE_ENV=development
PORT=5000

############################################
# Database (Supabase Postgres)
# Use the "Connection string" > "URI" from Supabase
############################################
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@YOUR_HOST:5432/postgres
# Optional: a second connection string for migrations or direct data access
DIRECT_URL=postgresql://postgres:YOUR_PASSWORD@YOUR_HOST:5432/postgres

############################################
# Supabase API (client-side + service usage)
# These NEXT_PUBLIC_ variables are exposed to the browser
############################################
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_PUBLIC_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

############################################
# Auth / sessions (adjust as you wire auth)
############################################
SESSION_SECRET=change-me-to-a-strong-random-string
JWT_SECRET=change-me-too-if-you-use-jwt

